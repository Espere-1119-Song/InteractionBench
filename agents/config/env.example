# Environment of the agent-harness runners. Copy this file outside the repository,
# fill in the values, and load it before a run:
#     cp agents/config/env.example ~/ibench_agents.env && chmod 600 ~/ibench_agents.env
#     set -a; source ~/ibench_agents.env; set +a
# Never commit a file that contains a key.

# --- all harnesses -------------------------------------------------------------------
# Local checkout of https://github.com/QwenLM/Qwen-MM-Plugins (absolute path).
# agents/config/mcp.json and agents/config/gemini_settings.json pass
# "${QWEN_MM_PLUGINS_ROOT}[core]" to uvx and have no default value. When the variable
# is not set, the CLI passes the literal text to uvx and the MCP server fails to start.
QWEN_MM_PLUGINS_ROOT=/path/to/Qwen-MM-Plugins

# Working directory of the agent sessions (absolute path). It holds .mcp.json,
# .gemini/settings.json and the clips the runners cut. Same as --agent-home.
IBENCH_AGENT_HOME=/path/to/agent_home

# Benchmark root and directory of the H.264 videos (<video_id>.mp4). Same as --data and
# --video-dir. Defaults: data/interactionbench and <data>/videos_h264.
#IBENCH_DATA=data/interactionbench
#IBENCH_VIDEOS_H264=data/interactionbench/videos_h264

# --- claude harness (Claude Code CLI) ------------------------------------------------
# Use an API key for parallel runs (--jobs > 1). Parallel sessions that share one
# interactive login can invalidate each other when the login token is refreshed.
ANTHROPIC_API_KEY=

# --- gemini harness (Gemini CLI) -----------------------------------------------------
GEMINI_API_KEY=
# The runners set GEMINI_CLI_TRUST_WORKSPACE=true for every gemini session.

# --- openai harness (agents/openai_agent.py) -----------------------------------------
# Model name on the endpoint.
OAI_MODEL=
# Endpoint of the agent. Default: the local cost proxy.
OAI_BASE_URL=http://127.0.0.1:8199/v1
# Leave unset when the cost proxy is used (the proxy holds the real key).
#OAI_API_KEY=
# Maximum number of model calls per session.
#OAI_MAX_TURNS=12

# --- cost proxy (agents/cost_proxy.py) -----------------------------------------------
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=
# List prices of the model in USD per 1M tokens. No price is shipped with the code:
# take the current values from the pricing page of the provider and update them when
# the model or the price list changes. With the value 0 the ledger records no spend
# and the limit below is never reached.
GPT_PRICE_IN=0.00
GPT_PRICE_CACHED=0.00
GPT_PRICE_OUT=0.00
# Spending limit in USD over all runs that write to the same ledger file.
GPT_BUDGET_USD=200
