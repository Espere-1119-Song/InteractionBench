+def _cap_images(messages: list[dict[str, Any]], cap: int) -> list[dict[str, Any]]:
+    """Anthropic's OpenAI-compatible endpoint rejects requests with more than 600
+    images ("too many images and documents"). When ADAPTER_MAX_IMAGES > 0, drop the OLDEST frames of the
+    current chunk until at most `cap` image items remain; text items are kept, and a user turn that loses
+    all its content gets a short text marker so the role alternation stays valid."""
+    total = sum(
+        1 for m in messages if isinstance(m.get("content"), list)
+        for it in m["content"] if isinstance(it, dict) and it.get("type") == "image_url"
+    )
+    if total <= cap:
+        return messages
+    to_drop = total - cap
+    out: list[dict[str, Any]] = []
+    for m in messages:
+        content = m.get("content")
+        if to_drop <= 0 or not isinstance(content, list):
+            out.append(m)
+            continue
+        kept = []
+        for it in content:
+            if to_drop > 0 and isinstance(it, dict) and it.get("type") == "image_url":
+                to_drop -= 1
+                continue
+            kept.append(it)
+        if not kept:
+            kept = [{"type": "text", "text": "[earlier frames omitted]"}]
+        out.append({**m, "content": kept})
+    LOGGER.info("image cap: kept %d of %d images (ADAPTER_MAX_IMAGES=%d)", cap, total, cap)
+    return out
+
